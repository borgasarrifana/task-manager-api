{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=YOUR_SUPABASE_HOST;Port=5432;Database=postgres;Username=postgres;Password=YOUR_PASSWORD"
  },
  "Jwt": {
    "Key": "GENERATE_YOUR_OWN_32+_CHARACTER_RANDOM_KEY",
    "Issuer": "TaskManager.Api",
    "Audience": "TaskManager.Api"
  },
    "App": {
    "FrontendBaseUrl": "https://task-manager-ui-ruby.vercel.app"
  },
  "Email": {
    "Provider": "Resend",
    "From": "Task Manager <notifications@mail.yourdomain.com>",
    "ResendApiKey": "<set via environment variable>"
  }
}